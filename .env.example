# =============================================================
# SANOS Y SALVOS — Variables de entorno para desarrollo local
# =============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Edita .env con tus valores (el .env NUNCA se sube a git)
#   3. Levanta el sistema: docker-compose up --build
# =============================================================

# ------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------
POSTGRES_USER=sanos_user
POSTGRES_PASSWORD=sanos_pass123

# Usuario que usan los microservicios para conectarse
DB_USER=sanos_user
DB_PASS=sanos_pass123

# ------------------------------------------------------------
# REDIS (Caché y sesiones)
# ------------------------------------------------------------
REDIS_PASS=redis123

# ------------------------------------------------------------
# RABBITMQ (Mensajería entre microservicios)
# ------------------------------------------------------------
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_pass123
RABBITMQ_USER=rabbit_user
RABBITMQ_PASS=rabbit_pass123

# ------------------------------------------------------------
# MINIO (Almacenamiento de fotos)
# ------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass123
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_pass123
MINIO_BUCKET=mascotas-fotos

# ------------------------------------------------------------
# JWT (Seguridad — cambiar en producción)
# ------------------------------------------------------------
# Clave de 64 caracteres hexadecimales para firmar los tokens JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------------------------
# GOOGLE MAPS (Geocodificación en ms-geolocalizacion)
# ------------------------------------------------------------
# Obtener en: https://console.cloud.google.com → APIs → Maps JavaScript API
# Para desarrollo local puedes dejar el valor de ejemplo (algunas funciones no funcionarán)
GOOGLE_MAPS_API_KEY=REEMPLAZAR_CON_TU_API_KEY

# ------------------------------------------------------------
# AGENTE AMIGO (n8n + Claude) — NO va aquí
# ------------------------------------------------------------
# La API Key de Anthropic/Claude se configura directamente en la UI de n8n:
#   1. Levantar con: docker-compose -f docker-compose.yml -f docker-compose.n8n.yml up -d
#   2. Abrir n8n en el navegador (puerto 5678)
#   3. Credentials → Add Credential → "Anthropic" → pegar tu API Key
#   4. Importar workflow: Workflows → Import → seleccionar workflow-actual.json
#   5. Activar el workflow con el toggle
# Obtener API Key en: https://console.anthropic.com
